import { test } from "node:test";
import assert from "node:assert/strict";
import { randomUUID } from "node:crypto";
import fs from "node:fs/promises";
import path from "node:path";
import mysql, { type RowDataPacket } from "mysql2/promise";
import request from "supertest";
import { createServer } from "../../src/server";
import { appConfig } from "../../src/utils/app-config";
import { dal } from "../../src/utils/dal";
import { cyber } from "../../src/utils/cyber";
import { imageStorage } from "../../src/utils/image-storage";
import { withVacationMcp } from "../../src/mcp/vacation-mcp";

// Run explicitly with npm run test:mysql against the configured local database.
// All test rows are rolled back, and only images generated by this test are removed.
test("real MySQL: admin login, vacation upload, stored data and image retrieval", async context => {
    const connection = await mysql.createConnection({
        host: appConfig.mysqlHost, port: appConfig.mysqlPort, user: appConfig.mysqlUser,
        password: appConfig.mysqlPassword, database: appConfig.mysqlDatabase,
        dateStrings: true, decimalNumbers: true
    });
    const images: string[] = [];
    const originalSave = imageStorage.save.bind(imageStorage);
    const email = "check-" + randomUUID() + "@example.com";
    let createdId: number | undefined;
    try {
        // Rollback is reliable only when the relevant tables use a transactional engine.
        const [tables] = await connection.execute<RowDataPacket[]>(
            "SELECT TABLE_NAME, ENGINE FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME IN ('users', 'vacations', 'likes')"
        );
        assert.equal(tables.length, 3);
        assert.ok(tables.every(table => table.ENGINE === "InnoDB"));
        await connection.beginTransaction();

        // The real route and services use one real connection so every test row stays in this transaction.
        context.mock.method(dal, "execute", async <T>(sql: string, values: unknown[] = []) => {
            const [rows] = await connection.execute(sql, values);
            return rows as T;
        });
        context.mock.method(imageStorage, "save", async file => {
            const name = await originalSave(file);
            images.push(name);
            return name;
        });

        const password = randomUUID();
        await connection.execute(
            "INSERT INTO users (firstName, lastName, email, passwordHash, roleId) VALUES (?, ?, ?, ?, 1)",
            ["Integration", "Admin", email, await cyber.hashPassword(password)]
        );
        const app = createServer();
        const login = await request(app).post("/api/login").send({ email, password });
        assert.equal(login.status, 200);
        assert.equal(cyber.readToken(login.body).roleId, 1);
        const today = new Date().toISOString().slice(0, 10);
        const input = { destination: "Paris", country: "France", continent: "Europe",
            description: "Integration test vacation.", startDate: today, endDate: today, price: "1290.50" };
        const png = Buffer.from("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jC9sAAAAASUVORK5CYII=", "base64");
        const result = await request(app).post("/api/vacations").auth(login.body, { type: "bearer" })
            .field(input).attach("image", png, "paris.png");
        assert.equal(result.status, 201);
        createdId = result.body.id;
        assert.equal(result.body.price, 1290.50);
        assert.equal(result.body.likesCount, 0);
        assert.equal(result.body.isLiked, false);
        assert.equal(images.length, 1);
        assert.equal(result.body.imageName, images[0]);
        const [stored] = await connection.execute<RowDataPacket[]>("SELECT * FROM vacations WHERE id = ?", [createdId]);
        assert.equal(stored[0].imageName, images[0]);
        assert.equal(stored[0].startDate, today);
        assert.equal(stored[0].endDate, today);
        assert.equal(stored[0].price, 1290.50);
        assert.equal(path.basename(stored[0].imageName), stored[0].imageName);
        const image = await request(app).get(result.body.imageUrl);
        assert.equal(image.status, 200);
        assert.deepEqual(image.body, png);
        const list = await request(app).get("/api/vacations?filter=active&page=1").auth(login.body, { type: "bearer" });
        assert.equal(list.status, 200);
        assert.equal(list.body.pageSize, 9);
        assert.ok(list.body.total >= 1);

        // Editing past dates must work without forcing a new image upload.
        const edited = await request(app).put("/api/vacations/" + createdId).auth(login.body, { type: "bearer" })
            .field({ ...input, startDate: "2020-01-01", endDate: "2020-01-02", price: "10000" });
        assert.equal(edited.status, 200);
        assert.equal(edited.body.imageName, images[0]);
        assert.equal(edited.body.price, 10000);
        const replaced = await request(app).put("/api/vacations/" + createdId).auth(login.body, { type: "bearer" })
            .field(input).attach("image", png, "replacement.png");
        assert.equal(replaced.status, 200);
        assert.notEqual(replaced.body.imageName, images[0]);
        await assert.rejects(fs.access(path.join(appConfig.uploadsPath, images[0])), { code: "ENOENT" });

        // A real relationship verifies report totals and ON DELETE CASCADE, not just SQL text.
        const memberEmail = "first-" + email;
        const otherEmail = "other-" + email;
        const member = await request(app).post("/api/register").send({ firstName: "Test", lastName: "Member", email: memberEmail, password });
        const other = await request(app).post("/api/register").send({ firstName: "Test", lastName: "Other", email: otherEmail, password });
        assert.equal(member.status, 201);
        assert.equal(other.status, 201);
        const duplicate = await request(app).post("/api/register").send({ firstName: "Test", lastName: "Member", email: memberEmail, password });
        assert.equal(duplicate.status, 409);
        for (let repeat = 0; repeat < 2; repeat++) {
            assert.equal((await request(app).put("/api/vacations/" + createdId + "/like").auth(member.body, { type: "bearer" })).status, 204);
        }
        const mine = await request(app).get("/api/vacations?filter=liked").auth(member.body, { type: "bearer" });
        const theirs = await request(app).get("/api/vacations?filter=liked").auth(other.body, { type: "bearer" });
        assert.equal(mine.body.total, 1);
        assert.equal(mine.body.vacations[0].likesCount, 1);
        assert.equal(theirs.body.total, 0);
        const report = await request(app).get("/api/vacations/report").auth(login.body, { type: "bearer" });
        assert.equal(report.status, 200);
        assert.equal(report.body.find((row: { id: number }) => row.id === createdId).likes, 1);
        const csv = await request(app).get("/api/vacations/report.csv").auth(login.body, { type: "bearer" });
        assert.equal(csv.status, 200);
        assert.match(csv.text, /Destination,Likes/);
        assert.match(csv.text, /"Paris",1/);

        // MCP performs real discovery and tool calls over the SDK transport against MySQL.
        await withVacationMcp(async client => {
            const discovered = await client.listTools();
            assert.equal(discovered.tools.length, 2);
            const stats = await client.callTool({ name: "vacation_statistics", arguments: { status: "active" } });
            assert.notEqual(stats.isError, true);
            const actualStats = JSON.parse((stats.content as { text: string }[])[0].text);
            const [expectedStats] = await connection.execute<RowDataPacket[]>(
                "SELECT COUNT(*) AS count, AVG(price) AS averagePrice FROM vacations WHERE startDate <= UTC_DATE() AND endDate >= UTC_DATE()"
            );
            assert.equal(Number(actualStats.count), expectedStats[0].count);
            assert.equal(Number(actualStats.averagePrice), Number(expectedStats[0].averagePrice));
            const search = await client.callTool({ name: "search_vacations", arguments: { status: "upcoming", continent: "Europe" } });
            assert.notEqual(search.isError, true);
            const found = JSON.parse((search.content as { text: string }[])[0].text);
            assert.ok(found.vacations.every((row: { continent: string; startDate: string }) => row.continent === "Europe" && row.startDate > today));
            const average = await client.callTool({ name: "vacation_statistics", arguments: {} });
            const [allStats] = await connection.execute<RowDataPacket[]>("SELECT AVG(price) AS averagePrice FROM vacations");
            assert.equal(Number(JSON.parse((average.content as { text: string }[])[0].text).averagePrice), Number(allStats[0].averagePrice));
        });
        const removed = await request(app).delete("/api/vacations/" + createdId).auth(login.body, { type: "bearer" });
        assert.equal(removed.status, 204);
        const [likes] = await connection.execute<RowDataPacket[]>("SELECT * FROM likes WHERE vacationId = ?", [createdId]);
        assert.equal(likes.length, 0);
        await assert.rejects(fs.access(path.join(appConfig.uploadsPath, replaced.body.imageName)), { code: "ENOENT" });
    } finally {
        // No commits or broad deletes: preserve all existing accounts, vacations and files.
        try {
            await connection.rollback();
            const [accounts] = await connection.execute<RowDataPacket[]>("SELECT id FROM users WHERE email = ?", [email]);
            assert.equal(accounts.length, 0);
            if (createdId !== undefined) {
                const [rows] = await connection.execute<RowDataPacket[]>("SELECT id FROM vacations WHERE id = ?", [createdId]);
                assert.equal(rows.length, 0);
            }
        } finally {
            try {
                for (const name of images) {
                    await imageStorage.remove(name);
                    await assert.rejects(fs.access(path.join(appConfig.uploadsPath, name)), { code: "ENOENT" });
                }
            } finally {
                await connection.end();
            }
        }
    }
});
